<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WatchLattice.DetectionChecks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Windows-only by design: Program refuses to make changes anywhere else, and `list` only describes them. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Description>Makes harmless, self-reverting changes of the kinds each WatchLattice module watches for and checks that the real module code reports them. Windows only. Not shipped with the hub.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WatchLattice.Common\WatchLattice.Common.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.Canary\WatchLattice.Canary.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.Persistence\WatchLattice.Persistence.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.HostsProxyWatchdog\WatchLattice.HostsProxyWatchdog.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.FirewallWatchdog\WatchLattice.FirewallWatchdog.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.DefenderWatchdog\WatchLattice.DefenderWatchdog.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.BrowserExtensionWatchdog\WatchLattice.BrowserExtensionWatchdog.csproj" />
    <ProjectReference Include="..\..\src\WatchLattice.ScriptHostAudit\WatchLattice.ScriptHostAudit.csproj" />
  </ItemGroup>

</Project>
