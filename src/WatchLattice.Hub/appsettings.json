{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Hub": {
    "RestartFailedModules": true,
    "RestartDelaySeconds": 30,
    "MaxRestartDelaySeconds": 600
  },
  "Modules": {
    "Decoy": { "Enabled": true },
    "Canary": { "Enabled": true },
    "DefenderWatchdog": { "Enabled": true },
    "FirewallWatchdog": { "Enabled": true },
    "HostsProxyWatchdog": { "Enabled": true },
    "BrowserExtensionWatchdog": { "Enabled": true },
    "Persistence": { "Enabled": true },
    "ScriptHostAudit": { "Enabled": false },
    "Updater": { "Enabled": true },
    "InstallIntegrity": { "Enabled": true }
  },
  "Updater": {
    "Repository": "notbrianbob/WatchLattice",
    "CheckIntervalHours": 12,
    "InitialDelaySeconds": 30,
    "CheckDevelopmentBuilds": false,
    "MaxPackageBytes": 268435456
  },
  "InstallIntegrity": {
    "CheckIntervalMinutes": 60,
    "InitialDelaySeconds": 120,
    "ReportUnexpectedBinaries": true,
    "IgnoredFiles": []
  },
  "Alerts": {
    "Enabled": true,
    "FeedPath": null,
    "HistoryLimit": 200,
    "EventLog": {
      "Enabled": true,
      "MinimumSeverity": "Info"
    },
    "DailySummary": {
      "Enabled": true,
      "Hour": 8,
      "TopRepeatedAlerts": 5
    }
  },
  "Persistence": {
    "CheckIntervalSeconds": 300,
    "WatchRegistry": true,
    "WatchStartupFolders": true,
    "WatchScheduledTasks": true,
    "WatchServices": true,
    "WatchWmiSubscriptions": true,
    "StartupFolders": [],
    "IgnoredEntries": [],
    "BaselinePath": null,
    "MaxStartupFileBytes": 4194304,
    "AutoVerifyAlerts": true,
    "FamiliarPublishers": []
  },
  "Decoy": {
    "Intensity": "Balanced",
    "ScanRoots": [],
    "MaxFilesPerSecond": 8,
    "BytesReadPerFile": 65536,
    "MaxFileSizeBytes": 268435456,
    "MinSweepIntervalSeconds": 60,
    "WriteScanLog": true,
    "ScanLogPath": null
  },
  "Canary": {
    "Folders": [],
    "FileNames": [],
    "MarkHidden": true,
    "CanarySizeBytes": 24576,
    "IntegrityCheckSeconds": 60,
    "AlertDebounceSeconds": 5,
    "RemoveCanariesOnStop": false,
    "AlertLogPath": null,
    "ManifestPath": null
  },
  "DefenderWatchdog": {
    "CheckIntervalSeconds": 300,
    "MaxSignatureAgeHours": 48,
    "CriticalSignatureAgeHours": 168,
    "TamperProtectionOffIsCritical": false,
    "MonitorSettings": true,
    "ReportBroadExclusions": true,
    "IgnoredExclusions": [],
    "MaxChangeAlertsPerCheck": 10,
    "StatePath": null,
    "AlertLogPath": null
  },
  "FirewallWatchdog": {
    "CheckIntervalSeconds": 300,
    "MonitorInboundAllowRules": false,
    "IgnoredInboundRules": [],
    "MaxRuleAlertsPerCheck": 10,
    "StatePath": null,
    "AlertLogPath": null
  },
  "HostsProxyWatchdog": {
    "CheckIntervalSeconds": 60,
    "WatchHostsFile": true,
    "WatchProxySettings": true,
    "IncludeBuiltInProtectedDomains": true,
    "ProtectedDomains": [],
    "IgnoredHosts": [],
    "MaxChangesPerAlert": 20,
    "MaxHostsFileBytes": 16777216,
    "HostsFilePath": null,
    "StatePath": null,
    "AlertLogPath": null
  },
  "BrowserExtensionWatchdog": {
    "CheckIntervalSeconds": 300,
    "WatchEdge": true,
    "WatchChrome": true,
    "WatchFirefox": true,
    "WatchPolicies": true,
    "ReportRemovals": true,
    "IgnoredExtensionIds": [],
    "MaxIndividualAlerts": 5,
    "MaxChangesPerAlert": 20,
    "MaxFileBytes": 33554432,
    "UserProfileFolders": [],
    "StatePath": null,
    "AlertLogPath": null
  },
  "ScriptHostAudit": {
    "CheckIntervalSeconds": 30,
    "IncludeBuiltInScriptHosts": true,
    "ScriptHosts": [],
    "IncludeBuiltInSuspiciousParents": true,
    "SuspiciousParents": [],
    "AllowedLaunches": [],
    "ApprovedLaunches": [],
    "MinimumSeverity": "Warning",
    "CommandLineInAlerts": true,
    "MaxIndividualAlerts": 5,
    "MaxChangesPerAlert": 20,
    "MaxEventsPerCheck": 5000,
    "StatePath": null,
    "AlertLogPath": null
  }
}
