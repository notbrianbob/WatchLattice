<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WatchLattice.Hub</RootNamespace>
    <!-- A plausible, scanner-like process name for the resident hub (the decoy relies on it).
         Kept from the ScanAlways name: installed v0.1.0 updaters require
         Hub/ScanAlways.Protection.Service.exe in every release package, and
         existing services point at this file. See docs/releasing.md. -->
    <AssemblyName>ScanAlways.Protection.Service</AssemblyName>
    <Description>The WatchLattice hub: one process that runs every enabled tool as a module. Runs as a console app or Windows service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WatchLattice.Common\WatchLattice.Common.csproj" />
    <ProjectReference Include="..\WatchLattice.Canary\WatchLattice.Canary.csproj" />
    <ProjectReference Include="..\WatchLattice.Decoy\WatchLattice.Decoy.csproj" />
    <ProjectReference Include="..\WatchLattice.DefenderWatchdog\WatchLattice.DefenderWatchdog.csproj" />
    <ProjectReference Include="..\WatchLattice.FirewallWatchdog\WatchLattice.FirewallWatchdog.csproj" />
    <ProjectReference Include="..\WatchLattice.HostsProxyWatchdog\WatchLattice.HostsProxyWatchdog.csproj" />
    <ProjectReference Include="..\WatchLattice.Persistence\WatchLattice.Persistence.csproj" />
    <ProjectReference Include="..\WatchLattice.Updater\WatchLattice.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
