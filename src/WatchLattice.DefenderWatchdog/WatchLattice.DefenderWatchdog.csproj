<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WatchLattice.DefenderWatchdog</RootNamespace>
    <AssemblyName>WatchLattice.DefenderWatchdog</AssemblyName>
    <Description>Read-only Microsoft Defender health watchdog for the WatchLattice suite. Runs as a module inside the WatchLattice hub.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.15" />
    <ProjectReference Include="..\WatchLattice.Common\WatchLattice.Common.csproj" />
  </ItemGroup>

</Project>
